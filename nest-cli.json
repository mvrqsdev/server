{
	"$schema": "https://json.schemastore.org/nest-cli",
	"collection": "@nestjs/schematics",
	"sourceRoot": "src",
	"entryFile": "infra/main",
	"compilerOptions": {
		"watchAssets": true,
		"deleteOutDir": true,
		"assets": [
			{ "include": "i18n/**/*", "watchAssets": true },
			"infra/mail/templates/**/*"
		]
	}
}
