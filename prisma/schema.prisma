generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  password     String
  master       Boolean   @default(false)
  isInRotation Boolean   @default(false)
  status       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime? @updatedAt

  Leads           Lead[]
  LeadsMessage    Message[]
  Schedulings     Scheduling[]
  Roles           UserRole[]
  Authentications Authentication[]
  Tokens          Token[]

  @@map("users")
}

model UserRole {
  agentId   String
  roleId    String
  createdAt DateTime @default(now())

  Agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)
  Role  Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([agentId, roleId])
  @@map("user_roles")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  slug        String           @unique
  color       String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime?        @updatedAt
  Agents      UserRole[]
  Permissions RolePermission[]

  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  Role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  Permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Permission {
  id          String    @id @default(uuid())
  name        String
  description String?
  slug        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  Roles RolePermission[]

  @@map("permissions")
}

enum TokenType {
  Invite
  PasswordRecovery
  EmailVerification
}

model Token {
  id        String    @id @default(uuid())
  agentId   String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  Agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("invites")
}

model Authentication {
  id        String    @id @default(uuid())
  token     String    @unique
  strategy  String
  agentId   String
  ip        String?
  userAgent String?
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Contact {
  id         String      @id @default(uuid())
  name       String
  number     String      @unique
  email      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime?   @updatedAt
  Leads      Lead[]
  IAMessages IAMessage[]

  @@map("contacts")
}

model Campaign {
  id         String    @id @default(uuid())
  name       String
  externalId String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime? @updatedAt

  Leads LeadCampaigns[]

  @@map("campaigns")
}

model LeadCampaigns {
  leadId     String
  campaignId String
  createdAt  DateTime @default(now())

  Lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([leadId, campaignId])
}

model Lead {
  id        String    @id @default(uuid())
  contactId String
  agentId   String?
  converted Boolean   @default(false)
  status    String
  value     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Contact     Contact         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Agent       User?           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  Schedulings Scheduling[]
  Messages    Message[]
  Campaigns   LeadCampaigns[]
  IAMessages  IAMessage[]

  @@map("leads")
}

model IAMessage {
  id          String    @id @default(uuid())
  leadId      String
  contactId   String
  content     String?
  mediaUrl    String?
  mediaKey    String?
  messageType String
  fromBot     Boolean   @default(true)
  sessionId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  Lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("ia_messages")
}

model Scheduling {
  id        String    @id @default(uuid())
  leadId    String
  agentId   String
  scheduled DateTime
  address   String
  status    String
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  Lead  Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  Agent User @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("schedulings")
}

model Message {
  id          String    @id @default(uuid())
  leadId      String
  agentId     String?
  content     String
  messageId   String
  messageType String
  fromMe      Boolean
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  Agent User? @relation(fields: [agentId], references: [id], onDelete: Cascade)
  Lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Instance {
  id              String    @id @default(uuid())
  name            String
  connection      String
  ownerJid        String?
  profileName     String?
  profilePicUrl   String?
  number          String?
  clientName      String?
  disconnectionAt DateTime?
  agentId         String
  session         Json?
  lastQrCode      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime? @updatedAt
}
